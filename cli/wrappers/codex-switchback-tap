#!/bin/zsh
# switchback-owned: native-codex-capture-entrypoint@1
# codex-main (observed): native Codex routes through Switchback's capture tap
# on :18771, then Switchback forwards the same native request to the shared
# Headroom proxy on :8787. This preserves Headroom optimization while restoring
# Switchback body capture for normal `codex` runs.
# Escape hatch: codex-native (direct). Power routing: codex-relay (Mode C).
set -euo pipefail

# Settings the `sb` TUI can change live (model / reasoning effort).
runtime="${SWITCHBACK_RUNTIME_ROOT:-${SB_RUNTIME_ROOT:-}}"
if [[ -z "$runtime" ]]; then
  switchback_command="$(command -v switchback 2>/dev/null || true)"
  if [[ -n "$switchback_command" ]]; then
    installed_runtime="${switchback_command:A:h:h}"
    if [[ -f "$installed_runtime/manifest.json" ]]; then
      runtime="$installed_runtime"
    fi
  fi
fi
if [[ -z "$runtime" ]]; then
  wrapper="${0:A}"
  runtime="${wrapper:h:h:h}/.switchback"
fi
runtime_env="$runtime/config/sb.env"
[[ -f "$runtime_env" ]] && source "$runtime_env"
legacy_env="${SWITCHBACK_LEGACY_ENV:-}"
if [[ -n "$legacy_env" && -f "$legacy_env" && "${legacy_env:A}" != "${runtime_env:A}" ]]; then
  source "$legacy_env"
fi
export SWITCHBACK_RUNTIME_ROOT="$runtime"
export SB_RUNTIME_ROOT="$runtime"
SB_CODEX_MODEL="${SB_CODEX_MODEL:-gpt-5.5}"
SB_CODEX_EFFORT="${SB_CODEX_EFFORT:-xhigh}"

capture_route="$runtime/config/native-codex-capture.json"
capture_port=18771
if [[ -e "$capture_route" ]]; then
  route_values=("${(@f)$(python3 - "$capture_route" <<'PY_ROUTE'
import hashlib,json,os,re,stat,sys
from pathlib import Path
p=Path(sys.argv[1]);s=p.lstat()
if not stat.S_ISREG(s.st_mode) or s.st_uid!=os.getuid() or s.st_mode&0o022 or s.st_size>65536:sys.exit("native Codex capture route is not an owned bounded file")
r=json.loads(p.read_text())
if r.get("schema")!="switchback/native-codex-capture@1":sys.exit("native Codex capture route schema mismatch")
port=r["tap_port"];label=r["service_label"];cfg=Path(r["capture_config"])
if type(port)!=int or not 1024<=port<=65535 or not re.fullmatch(r"[a-z0-9.-]+",label):sys.exit("invalid native Codex capture listener")
if hashlib.sha256(cfg.read_bytes()).hexdigest()!=r["capture_config_sha256"]:sys.exit("native Codex capture configuration changed")
taps=json.loads(cfg.read_text())["server"]["taps"]
if not any(t.get("bind")=="127.0.0.1:"+str(port) and t.get("capture_bodies") is True and t.get("headers",{}).get("x-switchback-harness")=="codex" for t in taps):sys.exit("native Codex route lacks an enrolled body tap")
print(port);print(label)
PY_ROUTE
  )}") || exit 69
  (( ${#route_values} == 2 )) || exit 69
  capture_port="$route_values[1]"
  launchctl kickstart "gui/${UID}/$route_values[2]" >/dev/null 2>&1 || true
  python3 - "$capture_port" <<'PY_READY' || exit 69
import socket,sys,time
deadline=time.monotonic()+15
while True:
 try:
  with socket.create_connection(("127.0.0.1",int(sys.argv[1])),timeout=.3):break
 except OSError:
  if time.monotonic()>deadline:sys.exit("native Codex capture tap unavailable")
  time.sleep(.2)
PY_READY
fi

config_overrides=(
  -c 'model_provider="switchback-main"'
  -c "model=\"${SB_CODEX_MODEL}\""
  -c "model_reasoning_effort=\"${SB_CODEX_EFFORT}\""
  -c 'approval_policy="never"'
  -c 'sandbox_mode="danger-full-access"'
  # requires_openai_auth=true => Codex uses its ChatGPT subscription OAuth for this
  # provider AND auto-refreshes the token (the same flow as native Codex), then sends
  # to the tap base_url. Without it, Codex sends a stale token, gets 401, and tells
  # you to "refresh token / sign in again". This makes the tap behave like native.
  -c "model_providers.switchback-main={name=\"Switchback capture -> Headroom\", base_url=\"http://127.0.0.1:$capture_port/v1\", wire_api=\"responses\", requires_openai_auth=true, supports_websockets=true}"
)

codex_args=(--dangerously-bypass-approvals-and-sandbox "${config_overrides[@]}")

case "${1:-}" in
  doctor)
    shift
    exec codex "${codex_args[@]}" doctor "$@"
    ;;
  *)
    exec codex "${codex_args[@]}" "$@"
    ;;
esac
